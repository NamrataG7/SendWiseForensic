{
  "name": "@sendwise-forensic/evidence-certificate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BSA 2023 §63 evidence certificate renderer (JSON + PDF) with hash-chain integrity helpers for SendWiseForensic.",
  "exports": {
    ".": "./src/index.ts",
    "./integrity": "./src/integrity.ts",
    "./schema": "./src/schema.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test dist/__tests__/*.test.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "zod": "^3.23.8"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
