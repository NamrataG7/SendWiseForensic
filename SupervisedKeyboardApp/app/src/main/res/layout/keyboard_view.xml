<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/keyboard_background">

    <!-- Suggestion strip (44dp above keys) -->
    <com.sendwiseforensic.supervisedkeyboard.ime.SuggestionStripView
        android:id="@+id/suggestion_strip"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/suggestion_strip_bg" />

    <!-- Keyboard container -->
    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/keyboard_background"
        android:keyBackground="@drawable/key_background"
        android:keyTextColor="@color/key_text"
        android:keyTextSize="20sp"
        android:shadowColor="@android:color/transparent"
        android:shadowRadius="0"
        android:keyPreviewLayout="@layout/key_preview" />

</LinearLayout>
