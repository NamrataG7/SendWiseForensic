<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_enrollment.xml

  Device enrollment screen. Consumes an officer-issued, single-use,
  30-minute-TTL enrollment code (format XXXX-XXXX) against
  POST /api/devices/enroll. This device never generates/displays a code —
  that concept belonged to the old parental-pairing flow this replaces.

  Two visual states toggled at runtime by EnrollmentActivity:
    * state_entry    - Idle / not yet enrolled. Shows code entry + submit.
    * state_enrolled - Device already enrolled; shows confirmation (NEVER
                       re-displays the raw ingest token, only a truncated
                       device ID).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sendwise_warning_hero_start"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Screen title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/enrollment_title"
            android:textColor="@color/sendwise_hero_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Main card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="24dp"
            android:elevation="2dp">

            <!-- ==================== STATE: ENTRY ==================== -->
            <LinearLayout
                android:id="@+id/state_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enrollment_menu_title"
                    android:textColor="@color/sendwise_purple_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/enrollment_intro"
                    android:textColor="@color/sendwise_text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp" />

                <EditText
                    android:id="@+id/edit_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:hint="@string/enrollment_code_hint"
                    android:inputType="textCapCharacters"
                    android:letterSpacing="0.1"
                    android:maxLength="9"
                    android:textColor="@color/sendwise_purple_deep"
                    android:textSize="24sp"
                    tools:text="A1B2-C3D4" />

                <Button
                    android:id="@+id/btn_enroll"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_btn_purple_filled"
                    android:text="@string/enrollment_button"
                    android:textColor="@color/white"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Status / progress / inline error text -->
                <LinearLayout
                    android:id="@+id/progress_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ProgressBar
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:indeterminateTint="@color/sendwise_purple_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/enrollment_enrolling"
                        android:textColor="@color/sendwise_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/sendwise_severity_high"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Couldn't reach the forensic-console server. Check your connection and try again."
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- ==================== STATE: ENROLLED ==================== -->
            <LinearLayout
                android:id="@+id/state_enrolled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enrollment_success_title"
                    android:textColor="@color/sendwise_severity_low"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_enrolled_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/sendwise_text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    tools:text="This device is linked for judicial supervision. Device ID: a1b2c3d4…" />
            </LinearLayout>
        </LinearLayout>

        <!-- Anchor for snackbars so they don't overlap the system nav bar -->
        <View
            android:id="@+id/snackbar_anchor"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

    </LinearLayout>
</ScrollView>
