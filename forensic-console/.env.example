# ---------------------------------------------------------------------------
# Supabase — officer/judicial-role authentication + Postgres (RLS-enforced)
# ---------------------------------------------------------------------------

# Public project URL for your Supabase instance. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (a.k.a. anon) key. Safe to expose to the browser; used by both
# the client SDK and the server-side `@supabase/ssr` cookie flow.
# (NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted as a fallback name — see
# utils/supabase/client.ts — but PUBLISHABLE_KEY is preferred going forward.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Service-role (secret) key. NEVER prefix with NEXT_PUBLIC_, never expose to
# the browser. Used by routes that must bypass RLS as SYSTEM (device
# enrollment, evidence ingest, audit append) via the admin client — see
# app/api/devices/enroll/route.ts and app/api/evidence/ingest/route.ts.
SUPABASE_SECRET_KEY=your-service-role-key

# Keeps the visible red "PROTOTYPE" banner + dummy-verification pills
# (packages/dummy-verification) active. This is a prototype system with
# stubbed Play Integrity / hardware-attestation / Aadhaar-style identity
# verification — do NOT set this to false without first replacing those
# stubs with real verification. See docs/PROTOTYPE_NOTICE.md.
NEXT_PUBLIC_PROTOTYPE=true

# ---------------------------------------------------------------------------
# Redis / KV — rate-limit counters and enrollment-code lookup caching.
# Optional: falls back to an in-memory stub (lost on redeploy/cold-start,
# fine for local dev, NOT fine for a real multi-instance Vercel deployment).
# ---------------------------------------------------------------------------

# Accepts REDIS_URL, SENDWISE_REDIS_URL, or sendwise_REDIS_URL (see
# lib/redis.ts) — use whichever your Redis/Vercel KV/Upstash integration
# injects automatically. Prod: rediss://default:<token>@<host>:<port>.
REDIS_URL=redis://localhost:6379
